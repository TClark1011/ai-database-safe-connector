{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["npm_config_manage_package_manager_versions"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
