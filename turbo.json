{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["XDG_RUNTIME_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
